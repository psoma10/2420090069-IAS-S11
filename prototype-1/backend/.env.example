# Copy to .env and fill in real values. .env is gitignored and must never be committed.

# PostgreSQL connection string. For Neon, copy the pooled connection string
# from the project dashboard.
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Signs the session cookie. Generate with:
#   python -c "import secrets; print(secrets.token_hex(32))"
# If unset, a random key is generated at startup and every restart logs users out.
SECRET_KEY=

FLASK_ENV=development
